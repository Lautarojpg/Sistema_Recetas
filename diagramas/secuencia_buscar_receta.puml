@startuml
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false

title Caso de Uso: Buscar Receta (buscarReceta) - Orientado a Objetos

actor "Usuario (Actor)" as Actor
participant "usuario : Usuario" as UserObj
participant "repositorio : RepositorioRecetas" as RepoObj
participant "receta : Receta" as RecetaObj

Actor -> RepoObj : buscar(busqueda)
activate RepoObj
  loop Para cada receta registrada en el sistema
    RepoObj -> RecetaObj : coincideCon(busqueda)
    activate RecetaObj
    RecetaObj -->> RepoObj : true / false
    deactivate RecetaObj
  end
  RepoObj -->> Actor : resultados
deactivate RepoObj

alt Caso 1: Resultados no vacíos
  Actor -> Actor : Muestra los resultados coincidentes
else Caso 2: Resultados vacíos y usuario con sesión iniciada
  Actor -> UserObj : solicita recetas propias
  activate UserObj
    UserObj -> RepoObj : buscarPorUsuario(usuario)
    activate RepoObj
      RepoObj -->> UserObj : recetasPropias
    deactivate RepoObj
    UserObj -->> Actor : Muestra mensaje "Sin resultados" e indica "Tus recetas" (recetasPropias)
  deactivate UserObj
else Caso 3: Resultados vacíos y visitante sin iniciar sesión
  Actor -> RepoObj : obtenerDestacadas()
  activate RepoObj
    RepoObj -->> Actor : recetasDestacadas
  deactivate RepoObj
  Actor -> Actor : Muestra mensaje "Sin resultados" e indica "Recetas destacadas" (recetasDestacadas)
end

@enduml
